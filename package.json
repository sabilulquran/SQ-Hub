{
  "name": "sq-hub",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @sq-hub/api run dev",
    "dev:web": "npm --workspace @sq-hub/web run dev",
    "build:api": "npm --workspace @sq-hub/api run build",
    "build:web": "npm --workspace @sq-hub/web run build",
    "build": "npm run build:api && npm run build:web",
    "typecheck:api": "npm --workspace @sq-hub/api run typecheck",
    "typecheck:web": "npm --workspace @sq-hub/web run typecheck",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "lint:api": "npm --workspace @sq-hub/api run lint",
    "lint:web": "npm --workspace @sq-hub/web run lint",
    "lint": "npm run lint:api && npm run lint:web",
    "test:api": "npm --workspace @sq-hub/api run test",
    "test:web": "npm --workspace @sq-hub/web run test",
    "test": "npm run test:api && npm run test:web",
    "migrate": "npm --workspace @sq-hub/api run migrate",
    "seed": "npm --workspace @sq-hub/api run seed",
    "access:admin": "npm --workspace @sq-hub/api run access:admin --",
    "db:up": "docker compose --env-file infra/.env.local -f infra/docker-compose.local.yml up -d postgres",
    "db:down": "docker compose --env-file infra/.env.local -f infra/docker-compose.local.yml down"
  }
}
