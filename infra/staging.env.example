SQ_HUB_DB_NAME=sq_hub_staging
SQ_HUB_DB_USER=sq_hub_staging
SQ_HUB_DB_PASSWORD=replace_with_a_long_random_staging_password

HCIS_CANONICAL_URL=https://hcis-staging.sabilulquran.or.id
KEYCLOAK_ISSUER=https://login.sabilulquran.or.id/realms/sq-staff-staging
MACHINE_TOKEN_AUDIENCE=sq-hub-api-staging
ALLOWED_MACHINE_CLIENTS=hcis-api-staging

# SQ Hub browser OIDC relying party. The real client secret belongs only in the VPS env.
SQ_HUB_OIDC_CLIENT_ID=sq-hub-staging
SQ_HUB_OIDC_CLIENT_SECRET=replace_with_keycloak_generated_staging_secret
SQ_HUB_OIDC_REDIRECT_URI=https://hub-staging.sabilulquran.or.id/auth/callback
SQ_HUB_OIDC_POST_LOGOUT_REDIRECT_URI=https://hub-staging.sabilulquran.or.id/
HUB_SESSION_IDLE_HOURS=8
HUB_SESSION_MAX_HOURS=12
HUB_OIDC_TRANSACTION_TTL_MINUTES=10
HUB_COOKIE_SECURE=true

# Go 5B server-only Staff directory integration. Never expose this client secret to the browser.
KEYCLOAK_DIRECTORY_BASE_URL=http://sq-identity-directory-staging:8080
KEYCLOAK_DIRECTORY_REALM=sq-staff-staging
KEYCLOAK_DIRECTORY_CLIENT_ID=sq-hub-directory-staging
KEYCLOAK_DIRECTORY_CLIENT_SECRET=replace_with_a_long_random_staging_directory_secret
SQ_IDENTITY_DIRECTORY_STAGING_NETWORK=sq_identity_directory_staging

# Runtime images. CI publishes these images to GHCR; VPS deployment pulls them with --no-build.
SQ_HUB_API_IMAGE=ghcr.io/imadjinasi/sq-hub-api:staging
SQ_HUB_WEB_IMAGE=ghcr.io/imadjinasi/sq-hub-web:staging

# Shared private application-integration network. Create once on the staging VPS.
SQ_PLATFORM_STAGING_NETWORK=sq_platform_staging

# Host-loopback smoke ports. Public Caddy terminates TLS and targets the web port.
SQ_HUB_BIND_ADDRESS=127.0.0.1
SQ_HUB_HTTP_PORT=18100
SQ_HUB_WEB_HTTP_PORT=18101

# Lean staging limits for the current shared VPS. Revisit before production.
SQ_HUB_DB_MEMORY_LIMIT=160m
SQ_HUB_API_MEMORY_LIMIT=128m
SQ_HUB_WEB_MEMORY_LIMIT=64m
