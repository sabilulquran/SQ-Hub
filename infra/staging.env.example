SQ_HUB_DB_NAME=sq_hub_staging
SQ_HUB_DB_USER=sq_hub_staging
SQ_HUB_DB_PASSWORD=replace_with_a_long_random_staging_password

HCIS_CANONICAL_URL=https://hcis-staging.sabilulquran.or.id
KEYCLOAK_ISSUER=https://login-staging.sabilulquran.or.id/realms/sq-staff-staging
MACHINE_TOKEN_AUDIENCE=sq-hub-api-staging
ALLOWED_MACHINE_CLIENTS=hcis-api-staging

# Shared private application-integration network. Create once on the staging VPS.
SQ_PLATFORM_STAGING_NETWORK=sq_platform_staging

# Host-loopback smoke test only; the Application Access consumer uses the Docker alias.
SQ_HUB_BIND_ADDRESS=127.0.0.1
SQ_HUB_HTTP_PORT=18100

SQ_HUB_DB_MEMORY_LIMIT=256m
SQ_HUB_API_MEMORY_LIMIT=192m
