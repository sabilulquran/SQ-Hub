FROM maven:3.9.11-eclipse-temurin-21-alpine AS trusted-device-builder

WORKDIR /workspace
COPY infra/keycloak/providers/trusted-device/pom.xml ./pom.xml
RUN set -eux; \
    for attempt in 1 2 3; do \
      mvn --batch-mode --no-transfer-progress dependency:go-offline && exit 0; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      sleep "$((attempt * 5))"; \
    done
COPY infra/keycloak/providers/trusted-device/src ./src
RUN set -eux; \
    for attempt in 1 2 3; do \
      mvn --batch-mode --no-transfer-progress verify && exit 0; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      sleep "$((attempt * 5))"; \
    done

FROM quay.io/keycloak/keycloak:26.7.2 AS builder

ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

WORKDIR /opt/keycloak
COPY infra/keycloak/themes/sq-hub /opt/keycloak/themes/sq-hub
COPY --from=trusted-device-builder /workspace/target/sq-trusted-device-1.0.0.jar /opt/keycloak/providers/sq-trusted-device.jar
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.7.2

COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY infra/keycloak/realm/sq-staff-staging-realm.json /opt/keycloak/data/import/sq-staff-staging-realm.json

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
