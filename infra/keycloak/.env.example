# Public staging identity endpoint.
KEYCLOAK_HOSTNAME=https://login-staging.sabilulquran.or.id
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_MEMORY_LIMIT=2g

# Dedicated Keycloak staging database. Never reuse HCIS/SQ Hub application DB credentials.
KEYCLOAK_DB_NAME=keycloak_staging
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=

# First bootstrap only. These variables are consumed only when the
# docker-compose.bootstrap.yml override is explicitly included.
# Remove/rotate them after the named administrator/recovery path is established.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=sq-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
