# Public staging identity endpoint.
KEYCLOAK_HOSTNAME=https://login.sabilulquran.or.id
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# Runtime image. Controlled deployment uses immutable sha-* tags from the organization namespace.
SQ_HUB_KEYCLOAK_IMAGE=ghcr.io/sabilulquran/sq-hub-keycloak:26.7.2-staging

# Lean staging limits for the current shared VPS. Keycloak documents 750 MB as
# the practical floor to approximate its former 512 MB heap; 768 MB keeps a
# small margin while avoiding the 2 GB production-oriented default.
KEYCLOAK_MEMORY_LIMIT=768m
KEYCLOAK_DB_MEMORY_LIMIT=192m

# Existing shared Caddy Docker network on the YSQ VPS.
EDGE_NETWORK=edge_proxy

# Go 5B internal server-only directory network. Only Keycloak and the SQ Hub API join it.
SQ_IDENTITY_DIRECTORY_STAGING_NETWORK=sq_identity_directory_staging
KEYCLOAK_DIRECTORY_CLIENT_ID=sq-hub-directory-staging
# Keep the real directory client secret only in controlled staging runtime configuration.
KEYCLOAK_DIRECTORY_CLIENT_SECRET=

# HUB-IMPL-011 Google broker credentials. Keep real values only in the
# controlled runtime secret store; they are consumed by the reconciliation
# script and are not required for normal container startup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dedicated Keycloak staging database. Never reuse HCIS/SQ Hub application DB credentials.
KEYCLOAK_DB_NAME=keycloak_staging
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=

# First bootstrap only. These variables are consumed only when the
# docker-compose.bootstrap.yml override is explicitly included.
# Remove/rotate them after the named administrator/recovery path is established.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=sq-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
