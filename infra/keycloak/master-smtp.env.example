# Non-secret shape for the production master-realm SMTP configuration.
# Copy to a root-readable runtime file outside Git and replace placeholders.
# Forgot Password is NOT operational until an authorized operator injects the
# SMTP credential/configuration and verifies actual delivery.
KEYCLOAK_MASTER_SMTP_HOST=replace_with_smtp_host
KEYCLOAK_MASTER_SMTP_PORT=587
KEYCLOAK_MASTER_SMTP_FROM=replace_with_sender_address
KEYCLOAK_MASTER_SMTP_FROM_DISPLAY_NAME=Akun SQ
KEYCLOAK_MASTER_SMTP_REPLY_TO=replace_with_reply_to_address
KEYCLOAK_MASTER_SMTP_STARTTLS=true
KEYCLOAK_MASTER_SMTP_SSL=false
KEYCLOAK_MASTER_SMTP_AUTH=true
KEYCLOAK_MASTER_SMTP_USER=replace_with_smtp_username
KEYCLOAK_MASTER_SMTP_PASSWORD=
