<#macro content>
  <div class="sq-brand-lockup" aria-label="Sabilul Qur'an">
    <img class="sq-brand-lockup__logo sq-brand-lockup__logo--light" src="${url.resourcesPath}/img/logo.png" alt="Sabilul Qur'an">
    <img class="sq-brand-lockup__logo sq-brand-lockup__logo--dark" src="${url.resourcesPath}/img/logo-white.png" alt="Sabilul Qur'an">
  </div>

  <div class="sq-brand-values" aria-label="Nilai Utsman">
    <div class="sq-brand-values__eyebrow">Nilai Utsman</div>
    <div class="sq-brand-values__grid">
      <article class="sq-brand-value sq-brand-value--yellow"><span class="sq-brand-value__icon" aria-hidden="true">♛</span><span><strong>Uswatun Hasanah</strong><small>Teladan dalam sikap</small></span></article>
      <article class="sq-brand-value sq-brand-value--cyan"><span class="sq-brand-value__icon" aria-hidden="true">↔</span><span><strong>Ta&apos;awun</strong><small>Saling membantu</small></span></article>
      <article class="sq-brand-value sq-brand-value--orange"><span class="sq-brand-value__icon" aria-hidden="true">◇</span><span><strong>Syaja&apos;ah</strong><small>Berani dalam kebenaran</small></span></article>
      <article class="sq-brand-value sq-brand-value--white"><span class="sq-brand-value__icon" aria-hidden="true">•••</span><span><strong>Musyawarah</strong><small>Keputusan bersama</small></span></article>
      <article class="sq-brand-value sq-brand-value--cyan"><span class="sq-brand-value__icon" aria-hidden="true">⌕</span><span><strong>Muhasabah</strong><small>Refleksi &amp; evaluasi</small></span></article>
      <article class="sq-brand-value sq-brand-value--yellow"><span class="sq-brand-value__icon" aria-hidden="true">⌕</span><span><strong>Amanah</strong><small>Tanggung jawab</small></span></article>
    </div>
  </div>

  <p class="sq-brand-security">Akun dan sesi dilindungi oleh layanan autentikasi Sabilul Qur&apos;an.</p>
  <p class="sq-login-footer">${msg("sqIdentityFooter")}</p>
</#macro>
